# Copy to .env for local Docker Compose only.

SECRET_KEY_BASE=replace-with-openssl-rand-hex-64

DATABASE_USER=manyfold
DATABASE_PASSWORD=manyfold_dev
DATABASE_NAME=manyfold

PUID=1000
PGID=1000
PORT=3214

# Recommended when the instance is reachable on a network.
MULTIUSER=enabled

# Leave empty for local HTTP. Set HTTPS_ONLY=enabled behind TLS.
HTTPS_ONLY=
PUBLIC_HOSTNAME=localhost
PUBLIC_PORT=3214

# Conservative defaults for local/smoke hosts.
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=8
